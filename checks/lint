#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ] || [ -z "${1:-}" ]; then
  exit 0
fi

FILE="$1"
if [ ! -f "$FILE" ]; then
  exit 0
fi

ROOT="${HERALD_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
ABS_FILE="$(realpath "$FILE")"
REL_FILE="${ABS_FILE#"$ROOT/"}"

case "$REL_FILE" in
  frontend/*.ts|frontend/*.tsx|frontend/*.js|frontend/*.jsx|frontend/*.mjs|checks/examples/*.ts|checks/examples/*.tsx|checks/examples/*.js|checks/examples/*.jsx|checks/examples/*.mjs)
    ESLINT_BIN="$ROOT/frontend/node_modules/.bin/eslint"
    if [ ! -x "$ESLINT_BIN" ]; then
      echo "lint: eslint missing (run ./setup)" >&2
      exit 2
    fi
    RC=0
    case "$REL_FILE" in
      frontend/*)
        OUT="$(cd "$ROOT/frontend" && "$ESLINT_BIN" --format json "$ABS_FILE")" || RC=$?
        ;;
      checks/examples/*)
        OUT="$(cd "$ROOT/frontend" && "$ESLINT_BIN" --format json --stdin --stdin-filename "$ROOT/frontend/src/$(basename "$ABS_FILE")" < "$ABS_FILE")" || RC=$?
        ;;
    esac
    if [ -z "$OUT" ]; then
      exit "$RC"
    fi
    node -e '
      const results = JSON.parse(process.argv[1]);
      const rc = Number(process.argv[3]);
      let hasError = false;
      for (const r of results) {
        for (const m of r.messages || []) {
          if (m.severity === 2) {
            hasError = true;
            const rule = m.ruleId ? ` (${m.ruleId})` : "";
            console.log(`${process.argv[2]}:${m.line || 1}: ${m.message}${rule}`);
          }
        }
      }
      if (hasError) process.exit(1);
      process.exit(rc);
    ' "$OUT" "$REL_FILE" "$RC"
    ;;
  *.py)
    RUFF_BIN="$ROOT/backend/.venv/bin/ruff"
    PY_BIN="$ROOT/backend/.venv/bin/python"
    if [ ! -x "$RUFF_BIN" ] || [ ! -x "$PY_BIN" ]; then
      echo "lint: ruff missing (run ./setup)" >&2
      exit 2
    fi
    RC=0
    OUT="$(cd "$ROOT/backend" && "$RUFF_BIN" check --output-format json "$ABS_FILE")" || RC=$?
    if [ -z "$OUT" ] || [ "$OUT" = "[]" ]; then
      exit "$RC"
    fi
    "$PY_BIN" -c '
import json, sys
items = json.loads(sys.argv[1])
rc = int(sys.argv[3])
for item in items:
    line = item.get("location", {}).get("row", 1)
    code = item.get("code", "")
    msg = item.get("message", "")
    prefix = f"{code}: " if code else ""
    print(f"{sys.argv[2]}:{line}: {prefix}{msg}")
sys.exit(1 if items else rc)
' "$OUT" "$REL_FILE" "$RC"
    ;;
  *)
    exit 0
    ;;
esac
