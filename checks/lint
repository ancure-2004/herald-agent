#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ] || [ -z "${1:-}" ]; then
  exit 0
fi

FILE="$1"
if [ ! -f "$FILE" ]; then
  exit 0
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ABS_FILE="$(realpath "$FILE")"
REL_FILE="${ABS_FILE#"$ROOT/"}"

case "$REL_FILE" in
  frontend/*.ts|frontend/*.tsx|frontend/*.js)
    OUT="$(cd "$ROOT/frontend" && ./node_modules/.bin/eslint --format json "$ABS_FILE" 2>/dev/null || true)"
    ;;
  checks/examples/*.ts|checks/examples/*.tsx|checks/examples/*.js)
    OUT="$(cd "$ROOT/frontend" && ./node_modules/.bin/eslint --format json --stdin --stdin-filename "$ROOT/frontend/src/$(basename "$ABS_FILE")" < "$ABS_FILE" 2>/dev/null || true)"
    ;;
esac

case "$REL_FILE" in
  frontend/*.ts|frontend/*.tsx|frontend/*.js|checks/examples/*.ts|checks/examples/*.tsx|checks/examples/*.js)
    if [ -z "$OUT" ]; then
      exit 0
    fi
    node -e '
      const results = JSON.parse(process.argv[1]);
      let hasError = false;
      for (const r of results) {
        for (const m of r.messages || []) {
          if (m.severity === 2) {
            hasError = true;
            const rule = m.ruleId ? ` (${m.ruleId})` : "";
            console.log(`${process.argv[2]}:${m.line || 1}: ${m.message}${rule}`);
          }
        }
      }
      process.exit(hasError ? 1 : 0);
    ' "$OUT" "$REL_FILE"
    ;;
  *.py)
    OUT="$(cd "$ROOT/backend" && "$ROOT/backend/.venv/bin/ruff" check --output-format json "$ABS_FILE" 2>/dev/null || true)"
    if [ -z "$OUT" ] || [ "$OUT" = "[]" ]; then
      exit 0
    fi
    "$ROOT/backend/.venv/bin/python" -c '
import json, sys
items = json.loads(sys.argv[1])
for item in items:
    line = item.get("location", {}).get("row", 1)
    code = item.get("code", "")
    msg = item.get("message", "")
    prefix = f"{code}: " if code else ""
    print(f"{sys.argv[2]}:{line}: {prefix}{msg}")
sys.exit(1 if items else 0)
' "$OUT" "$REL_FILE"
    ;;
  *)
    exit 0
    ;;
esac
