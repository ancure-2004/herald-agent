# ==============================================================================
# Personal OS & CRM - Backend Environment Configuration (.env.example)
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` containing production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
PROJECT_NAME="Personal OS & CRM"
ENVIRONMENT=development                # development | staging | production
DEBUG=true                            # Set to false in production
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 2. Security & Networking
# ------------------------------------------------------------------------------
# Generate a secure 32+ character key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production-to-a-secure-random-32-char-string

# Comma-separated list of allowed frontend origins (no wildcards in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# Comma-separated list of allowed host headers
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver

# Maximum request body size limit in bytes (10MB default)
MAX_REQUEST_BODY_SIZE=10485760

# Rate limits (slowapi string syntax: "120/minute", "20/minute")
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_EXPENSIVE=20/minute

# ------------------------------------------------------------------------------
# 3. Database Connections
# ------------------------------------------------------------------------------
# Default is local SQLite: sqlite:///personal_os.db
# For PostgreSQL (Neon/Supabase): postgresql+psycopg2://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///personal_os.db

# Optional direct connection string when using pooled serverless proxies
DIRECT_URL=

# ------------------------------------------------------------------------------
# 4. Demo Engine & Outreach Defaults
# ------------------------------------------------------------------------------
# Base URL for the 3-template Dental Clinic Engine
DEMO_ENGINE_BASE_URL=http://localhost:3001
DEFAULT_DEAL_VALUE_INR=15000

# ------------------------------------------------------------------------------
# 5. External APIs (Search, Scraping & AI)
# ------------------------------------------------------------------------------
# Google Places API Key for clinic discovery & phone verification
GOOGLE_PLACES_API_KEY=

# Brave Search API Key for domain & website checks
BRAVE_API_KEY=

# Serper API Key for Google Search Fallback
SERPER_API_KEY=

# Google Gemini API Key for copilot & structured research
GEMINI_API_KEY=

# Groq API Key for fast local LLM inferences
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 6. Telegram Bot Integration (Away-mode & Hot-Lead Alerts)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
