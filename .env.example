# ==============================================================================
# Herald - Multi-Agent Operations Engine - Environment Configuration (.env.example)
# Copy this file to `.env` (or frontend/.env.local) and customize for your setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
PROJECT_NAME="Herald - Multi-Agent Operations Engine"
ENVIRONMENT=development                # development | staging | production
DEBUG=true                            # Set to false in production
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 2. Security & Networking
# ------------------------------------------------------------------------------
# Generate a secure 32+ character key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production-to-a-secure-random-32-char-string

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# Comma-separated list of allowed host headers
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver

# Maximum request body size limit in bytes (10MB default)
MAX_REQUEST_BODY_SIZE=10485760

# Rate limits (slowapi syntax)
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_EXPENSIVE=20/minute

# ------------------------------------------------------------------------------
# 3. Database Connection
# ------------------------------------------------------------------------------
# Default is local SQLite: sqlite:///personal_os.db
# For PostgreSQL: postgresql+psycopg2://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///personal_os.db

# Optional direct connection string for serverless pooler bypass
DIRECT_URL=

# ------------------------------------------------------------------------------
# 4. Engine & Outreach Defaults
# ------------------------------------------------------------------------------
# Base URL for the demo preview engine
DEMO_ENGINE_BASE_URL=http://localhost:3001
DEFAULT_DEAL_VALUE_INR=15000

# ------------------------------------------------------------------------------
# 5. External APIs & AI Inference (Optional)
# ------------------------------------------------------------------------------
# Google Places API Key (optional - gated by monthly soft-limit QuotaGuard)
GOOGLE_PLACES_API_KEY=

# Google Gemini API Key for copilot & RAG embeddings
GEMINI_API_KEY=

# Groq API Key for fast LLM inferences
GROQ_API_KEY=

# Telegram Bot Integration for away-mode alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 6. Autopilot Lead Pipeline
# ------------------------------------------------------------------------------
# User-Agent header with contact info for external search providers
CONTACT_USER_AGENT="Herald-Autopilot/2.0 (contact: info@example.com)"

# Ordered discovery providers: google, local_pool
DISCOVERY_PROVIDERS=google,local_pool

# DuckDuckGo search throttle and cache settings
SEARCH_MIN_INTERVAL_SECONDS=4.0
SEARCH_CACHE_TTL_DAYS=30

# Google Places QuotaGuard monthly soft limits
GOOGLE_MAX_PAGES_PER_QUERY=1
GOOGLE_MONTHLY_SOFT_LIMIT_TEXT_SEARCH=900
GOOGLE_MONTHLY_SOFT_LIMIT_DETAILS=900

# Action when search fails: "hold" (drop) or "allow_flagged"
WEBSITE_CHECK_ON_UNVERIFIED=hold

# Testing mode maximum candidate target limit
TEST_MODE_MAX_TARGET=3

# Subprocess recorder timeout per clinic in seconds
RECORDER_TIMEOUT_PER_CLINIC_SECONDS=90

# Optional flag: seed sample demo leads on first startup (true / false)
SEED_SAMPLE_DATA=false

# Optional flag: force live Playwright recording in testing mode (true / false)
FORCE_LIVE_RECORDER=false

# ------------------------------------------------------------------------------
# 7. Frontend Public API Base URL (for frontend/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
