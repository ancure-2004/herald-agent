#!/bin/sh
# Prepare a fresh checkout of herald for work and for ./verify: the backend's venv with its dev install, and the
# frontend's and the Verifier's npm packages. The engines are left out (./verify does not use them). Everything lands
# inside this checkout; npm and pip caches follow npm_config_cache and PIP_CACHE_DIR when set.
set -eu
cd "$(dirname "$0")"

echo "setup: backend venv"
python3 -m venv backend/.venv
# requirements.txt is optional: once backend/pyproject.toml lists every dependency, the file is deleted (H-21).
if [ -f backend/requirements.txt ]; then extra="-r requirements.txt"; else extra=""; fi
# shellcheck disable=SC2086
(cd backend && .venv/bin/pip install --quiet --disable-pip-version-check -e ".[dev]" $extra)

echo "setup: frontend packages"
(cd frontend && npm ci --no-audit --no-fund --loglevel=error)

echo "setup: verifier packages (system Chrome, no browser download)"
(cd verifier && PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm ci --no-audit --no-fund --loglevel=error)

echo "setup: done"
